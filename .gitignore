# Python caches
__pycache__/
*.pyc

# Test caches and local test/runtime temp areas
/.pytest_cache/
/pytest-cache-files-*
/.test_runtime/
/.tmp_windows_temp/

# Local environments
/.venv/

# Generated web build artifacts. The web frontend's static sources
# (index.html, app.js, style.css, i18n.js) are tracked, but the Python
# domain copy, the dataset/localization snapshots, and the exported
# design-tokens JSON are produced on every push by tools/build_web.py
# and the Pages deploy workflow. Keep src/ as the single source of truth.
/web/python/
/web/data/
/web/design_tokens.json
/web/version.js
/web/icons/
/web/.venv/

# Build and release outputs
/build/
/dist/

# Local temporary workspaces and probes
/tmp/
/tmp*/
/layout_probe.ini
/tmp_layout_probe.png

# Local clean export prepared from this workspace
/TavPer_Repository/

# SVG vector sources (kept outside the repo)
/*.svg
