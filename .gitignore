# Python caches
__pycache__/
*.pyc

# Test caches and local test/runtime temp areas
/.pytest_cache/
/pytest-cache-files-*
/.test_runtime/
/.tmp_windows_temp/

# Local environments
/.venv/

# Stale Reflex web port working directory — the web port has been removed
# from the project, but a local /web/ may persist on disk while files are
# still locked by a background process. Ignore it wholesale so git never
# tracks anything under it again.
/web/

# Build and release outputs
/build/
/dist/

# Local temporary workspaces and probes
/tmp/
/tmp*/
/layout_probe.ini
/tmp_layout_probe.png

# Local clean export prepared from this workspace
/TavPer_Repository/

# SVG vector sources (kept outside the repo)
/*.svg
